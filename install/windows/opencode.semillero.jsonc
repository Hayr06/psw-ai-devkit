{
  "$schema": "https://opencode.ai/config.json",

  // Global OpenCode config for the PSW semillero. Written by install.ps1 to ~/.config/opencode/opencode.jsonc.
  // All model traffic goes to the PSW gateway on the VM; the PCAI token never reaches this PC.

  "provider": {
    "psw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "PSW",
      "options": {
        // Personal key issued by the organizer; install.ps1 stores it in the user environment variable PSW_LLM_KEY.
        "apiKey": "{env:PSW_LLM_KEY}",
        "baseURL": "https://fabrica.pyxoomsaas.com/modelo/v1",
        // An answer with reasoning plus a whole file can take minutes.
        "timeout": 1800000,
        "chunkTimeout": 300000
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen 3.6 (PSW)",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 262144, "output": 16384 },
          "options": {
            "max_tokens": 16384,
            "top_p": 0.95,
            "repetition_penalty": 1.0,
            "presence_penalty": 0.0,
            // Directly in options: OpenCode does not forward a nested extra body block.
            "chat_template_kwargs": { "enable_thinking": true }
          }
        }
      }
    }
  },

  "model": "psw/qwen3.6",
  "small_model": "psw/qwen3.6",
  "enabled_providers": ["psw"],

  "autoupdate": false,
  "share": "disabled"
}
